rules_version = '2';

// Security rules for the household app.
// Default: everything not matched below is denied.
// Paste into Firebase console → Firestore Database → Rules → Publish
// (or deploy with `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid));
    }

    // Admins: accounts with a document in admins/{uid}, created by hand in the console.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isMemberOf(hid) {
      return signedIn() && request.auth.uid in householdDoc(hid).data.memberIds;
    }

    // ---------------------------------------------------------------
    // users/{uid} — each person's own profile. Nobody else can read it.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'householdId', 'createdAt'])
        && (request.resource.data.householdId == null || request.resource.data.householdId is string);
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // households/{hid}
    //   - only the owner sets up and edits the household and its list
    //   - the partner answers their own preferences, takes part in the
    //     plan, uses the board and suggests changes the owner decides on
    //   - nobody can change who owns it
    //   - joining is only possible together with a valid invite
    //   - a non-owner can remove themselves; only the owner can delete
    // ---------------------------------------------------------------
    match /households/{hid} {
      // A missing household reads as "doesn't exist" rather than "denied".
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.memberIds);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0].uid == request.auth.uid
        && withinLimits();

      allow update: if signedIn() && withinLimits()
        && (ownerEdit() || memberEdit() || joining(hid) || leaving());

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      function withinLimits() {
        return request.resource.data.responsibilities.size() <= 500
          && request.resource.data.members.size() <= 2
          && request.resource.data.memberIds.size() <= 2
          && request.resource.data.get('suggestions', []).size() <= 200
          && request.resource.data.get('swaps', []).size() <= 300
          && request.resource.data.get('notes', []).size() <= 200;
      }

      // The owner can change anything except who owns it and who's in it.
      function ownerEdit() {
        return request.auth.uid == resource.data.ownerId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberIds == resource.data.memberIds;
      }

      // The partner: answers for themselves only; takes part in the plan (rebalance with
      // their answers, say yes, swap, claim, tick off); suggests list changes; uses the board.
      // (Whether the household has a subscription is checked by the app: the rules protect
      // who may change what, not what someone has paid for.)
      function memberEdit() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let preferencesChanged = request.resource.data.get('preferences', {})
          .diff(resource.data.get('preferences', {})).affectedKeys();
        return request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.ownerId
          && changed.hasOnly(['suggestions', 'preferences', 'plan', 'swaps', 'completions',
                              'reshare', 'reshuffle', 'planSeed', 'previousAssignments', 'notes', 'updatedAt'])
          && preferencesChanged.hasOnly([request.auth.uid]);
      }

      // The partner adds exactly themselves next to the organiser (who stays as is), in
      // the same batch that marks a valid invite for this household as used by them now.
      // An invite works once: rejoining later needs a new one.
      function joining(hid) {
        let invite = getAfter(/databases/$(database)/documents/invites/$(request.resource.data.joinInvite)).data;
        let me = request.resource.data.members[1];
        return !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'joinInvite', 'updatedAt'])
          && resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] == resource.data.members[0]
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && me.keys().hasOnly(['uid', 'name', 'role', 'joinedAt'])
          && me.uid == request.auth.uid && me.role == 'member'
          && me.name is string && me.name.size() <= 40
          && invite.householdId == hid
          && invite.usedBy == request.auth.uid
          && invite.usedAt == request.time;
      }

      // The partner removes themselves; the organiser's entry stays exactly as it was.
      function leaving() {
        return request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'updatedAt'])
          && request.resource.data.memberIds == [resource.data.ownerId]
          && request.resource.data.members.size() == 1
          && request.resource.data.members[0].uid == resource.data.ownerId
          && resource.data.members.hasAll(request.resource.data.members);
      }
    }

    // ---------------------------------------------------------------
    // invites/{code} — one-time join links. The code is the secret, so
    // single documents can be read but the collection can't be listed.
    // ---------------------------------------------------------------
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.size() >= 12
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.expiresAt > request.time
        && isMemberOf(request.resource.data.householdId);

      // Redeeming: the person joining marks it as used by themselves, once.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']);

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // subscriptions/{uid} — access granted by hand from the admin panel
    // (gifts, tests). It belongs to the household's organiser; everyone in
    // that household can read it. Only an admin can write here.
    // ---------------------------------------------------------------
    match /subscriptions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || ownerOfMyHousehold(uid) || isAdmin());
      allow write: if isAdmin();

      function ownerOfMyHousehold(ownerUid) {
        let hid = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
        let household = householdDoc(hid).data;
        return hid is string
          && household.ownerId == ownerUid
          && request.auth.uid in household.memberIds;
      }
    }

    // ---------------------------------------------------------------
    // premiumRequests/{uid} — "Request access" while payments aren't open. People create or renew
    // their own request; only an admin approves, denies or revokes.
    // ---------------------------------------------------------------
    match /premiumRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && validRequest();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && resource.data.status in ['denied', 'revoked', 'cancelled'] && validRequest());
      allow delete: if isAdmin();

      function validRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'email', 'name', 'householdId', 'members', 'status', 'requestedAt'])
          && d.uid == request.auth.uid
          && d.status == 'pending'
          && d.requestedAt == request.time
          && d.get('email', '') is string && d.get('email', '').size() <= 254
          && d.get('name', '') is string && d.get('name', '').size() <= 60
          && (d.get('householdId', null) == null || (d.householdId is string && d.householdId.size() <= 64))
          && (d.get('members', 1) is int && d.get('members', 1) >= 1 && d.get('members', 1) <= 12);
      }
    }

    // ---------------------------------------------------------------
    // customers/{uid} — the Stripe extension's data. People start a checkout
    // for themselves only, with the real prices; the trial only comes with
    // the yearly price and only for the configured number of days.
    // Everything else here is written by the extension (admin access).
    // Replace the two price IDs below with the ones in js/config.js.
    // ---------------------------------------------------------------
    match /customers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /checkout_sessions/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && validCheckout(request.resource.data);
        allow update, delete: if false;
      }
      match /subscriptions/{id} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || organiserOfMyHousehold(uid));
        allow write: if false;
      }
      match /payments/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      match /invoices/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    function monthlyPrice() { return 'REPLACE_WITH_MONTHLY_PRICE_ID'; }
    function yearlyPrice() { return 'REPLACE_WITH_YEARLY_PRICE_ID'; }
    function trialDays() { return 21; }
    // Where Stripe may send people back to: the app (and localhost for testing).
    // Change this if the app moves to another address.
    function appUrl() { return '^(https://mefenir[.]github[.]io/taskmatch/|http://localhost(:[0-9]+)?/).*'; }

    function validCheckout(d) {
      return d.keys().hasOnly(['price', 'success_url', 'cancel_url', 'allow_promotion_codes', 'client_reference_id',
                               'metadata', 'locale', 'trial_period_days', 'expires_at'])
        && (!('expires_at' in d) || (d.expires_at is int && d.expires_at <= request.time.toMillis() / 1000 + 3600))
        && d.price in [monthlyPrice(), yearlyPrice()]
        && d.success_url is string && d.success_url.matches(appUrl())
        && d.cancel_url is string && d.cancel_url.matches(appUrl())
        && d.client_reference_id == request.auth.uid
        && (!('trial_period_days' in d) || (d.price == yearlyPrice() && d.trial_period_days == trialDays()));
    }

    function organiserOfMyHousehold(ownerUid) {
      let hid = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
      return hid is string
        && householdDoc(hid).data.ownerId == ownerUid
        && request.auth.uid in householdDoc(hid).data.memberIds;
    }

    // Products and prices synced from Stripe: public, read-only.
    match /products/{id} {
      allow read: if true;
      allow write: if false;
      match /prices/{price} { allow read: if true; allow write: if false; }
      match /tax_rates/{rate} { allow read: if true; allow write: if false; }
    }

    // ---------------------------------------------------------------
    // metrics/{hid} — funnel step times for the admin panel. Members add
    // steps for their own household; only admins can list or read them all.
    // ---------------------------------------------------------------
    match /metrics/{hid} {
      allow get: if isAdmin() || isMemberOf(hid);
      allow list: if isAdmin();
      allow create, update: if signedIn() && isMemberOf(hid)
        && request.resource.data.keys().hasOnly(['created', 'listed', 'rated', 'paywall', 'checkout', 'subscribed',
                                                 'invited', 'joined', 'reviewed', 'started', 'activeDays'])
        && request.resource.data.get('activeDays', []).size() <= 400;
      allow delete: if false;
    }

    // admins/{uid} — only readable by that admin, never writable from the app.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
